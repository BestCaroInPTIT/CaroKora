<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kora_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Kora Mark"
            android:src="@drawable/ic_kora_mark" />

        <TextView
            android:id="@+id/lblTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:text="ONLINE PLAYERS"
            android:textColor="@color/kora_ink"
            android:textSize="17sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginBottom="14dp"
        android:background="@color/kora_ink" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SEARCH PLAYER"
        android:textColor="@color/kora_muted"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/txtSearch"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_box_outline"
        android:hint="Game ID or name"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/kora_ink"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lblTotalOnline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TOTAL ONLINE PLAYERS: 0"
            android:textColor="@color/kora_ink"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRefreshOnline"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_btn_neutral"
            android:minHeight="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:text="REFRESH"
            android:textColor="@color/kora_ink"
            android:textSize="10.5sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

    <ListView
        android:id="@+id/lwOnlinePlayers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:listSelector="@android:color/transparent" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_neutral"
        android:text="&lt; Back"
        android:textAllCaps="false"
        android:textColor="@color/kora_ink"
        android:textSize="13.5sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

</LinearLayout>
