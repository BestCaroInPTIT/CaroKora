<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rowOnlinePlayerRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="blocksDescendants"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Khung nguoi choi ben trai (cham vao de thach dau neu AVAILABLE; IN MATCH thi khong active) -->
    <LinearLayout
        android:id="@+id/cardPlayerBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_box_zebra"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lblIndex"
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="1"
                android:textColor="@color/kora_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblItemGameID"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:text="Bn"
                android:textColor="@color/kora_ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblItemStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="POINTS 0  ·  RANK #1"
                android:textColor="@color/kora_ink"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/lblItemStatus"
            android:layout_width="106dp"
            android:layout_height="28dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_status_available"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="AVAILABLE"
            android:textColor="@color/kora_ink"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Nut View profile > nam NGOAI khung nguoi choi ben phai chuan hinh thiet ke -->
    <Button
        android:id="@+id/btnViewProfile"
        android:layout_width="112dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_btn_neutral"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="6dp"
        android:singleLine="true"
        android:text="View profile &gt;"
        android:textAllCaps="false"
        android:textColor="@color/kora_ink"
        android:textSize="10.5sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

</LinearLayout>
