<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rowOnlinePlayerRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_box_outline"
    android:descendantFocusability="blocksDescendants"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Hang 1 chuan Figma Slide 10: ID 1 | Bn | POINTS 1234 · RANK #134 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lblIndex"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:text="ID 1"
            android:textColor="@color/kora_muted"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblItemGameID"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="Bn"
            android:textColor="@color/kora_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblItemStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POINTS 12.0  ·  RANK #1"
            android:textColor="@color/kora_ink"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Hang 2 chuan Figma Slide 10: AVAILABLE / IN MATCH pill + View profile > -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lblItemStatus"
            android:layout_width="96dp"
            android:layout_height="28dp"
            android:background="@color/kora_mint"
            android:gravity="center"
            android:text="AVAILABLE"
            android:textColor="@color/kora_ink"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnViewProfile"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_neutral"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="View profile &gt;"
            android:textAllCaps="false"
            android:textColor="@color/kora_ink"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>
