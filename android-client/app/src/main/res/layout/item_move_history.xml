<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowMoveHistoryRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_move_row_white"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/lblMoveOrder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.6"
        android:fontFamily="monospace"
        android:text="1"
        android:textColor="@color/kora_ink"
        android:textSize="10.5sp" />

    <TextView
        android:id="@+id/lblMoveTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.1"
        android:fontFamily="monospace"
        android:text="20:51"
        android:textColor="@color/kora_ink"
        android:textSize="10.5sp" />

    <TextView
        android:id="@+id/lblMoveTurn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.1"
        android:fontFamily="monospace"
        android:text="A"
        android:textColor="@color/kora_ink"
        android:textSize="10.5sp" />

    <TextView
        android:id="@+id/lblMoveCoord"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:fontFamily="monospace"
        android:text="H4"
        android:textColor="@color/kora_ink"
        android:textSize="10.5sp"
        android:textStyle="bold" />

</LinearLayout>
