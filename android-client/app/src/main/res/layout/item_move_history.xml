<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowMoveHistoryRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kora_surface"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/lblMoveOrder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.6"
        android:fontFamily="monospace"
        android:text="1"
        android:textColor="@color/kora_ink"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/lblMoveTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.1"
        android:fontFamily="monospace"
        android:text="20:51"
        android:textColor="@color/kora_ink"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/lblMoveTurn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:text="A"
        android:textColor="@color/kora_ink"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lblMoveCoord"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.9"
        android:fontFamily="monospace"
        android:gravity="end"
        android:text="H4"
        android:textColor="@color/kora_ink"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
