<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kora_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Kora Mark"
            android:src="@drawable/ic_kora_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:text="PLAYER HOME"
            android:textColor="@color/kora_ink"
            android:textSize="17sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:layout_marginBottom="16dp"
        android:background="@color/kora_ink" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgAvatar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_box_outline"
            android:clickable="true"
            android:contentDescription="Player Avatar"
            android:focusable="true"
            android:padding="2dp"
            android:src="@drawable/ic_kora_avatar" />

        <TextView
            android:id="@+id/lblPlayerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:text="HELLO, A"
            android:textColor="@color/kora_ink"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:layout_marginTop="16dp"
        android:background="@color/kora_ink" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnPlay"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/bg_btn_mint"
        android:fontFamily="monospace"
        android:text="PLAY"
        android:textColor="@color/kora_ink"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

    <Button
        android:id="@+id/btnViewRanking"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_neutral"
        android:fontFamily="monospace"
        android:text="VIEW RANKING"
        android:textColor="@color/kora_ink"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.15" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnViewOnlinePlayers"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1.35"
            android:background="@drawable/bg_btn_neutral"
            android:fontFamily="monospace"
            android:minWidth="0dp"
            android:paddingHorizontal="6dp"
            android:text="VIEW ONLINE PLAYERS"
            android:textColor="@color/kora_ink"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:layout_weight="0.9"
            android:background="@drawable/bg_btn_blush"
            android:fontFamily="monospace"
            android:minWidth="0dp"
            android:paddingHorizontal="6dp"
            android:text="LOG OUT"
            android:textColor="@color/kora_ink"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>
