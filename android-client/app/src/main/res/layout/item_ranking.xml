<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowRanking"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_box_zebra"
    android:orientation="horizontal"
    android:padding="10dp">

    <TextView
        android:id="@+id/lblRankingRank"
        android:layout_width="34dp"
        android:layout_height="match_parent"
        android:fontFamily="monospace"
        android:gravity="center_vertical"
        android:text="#1"
        android:textColor="@color/kora_ink"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lblRankingPlayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="GAME ID"
            android:textColor="@color/kora_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblRankingStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="monospace"
            android:text="W 0  D 0  L 0  MATCHES 0"
            android:textColor="@color/kora_muted"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/lblRankingScore"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:fontFamily="monospace"
        android:gravity="center_vertical|end"
        android:text="0.0 PT"
        android:textColor="@color/kora_ink"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
