<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kora_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/lblMatchTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:text="MATCH DETAIL"
            android:textColor="@color/kora_ink"
            android:textSize="17sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:layout_marginBottom="14dp"
        android:background="@color/kora_ink" />

    <TextView
        android:id="@+id/lblOpponentName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="OPPONENT: --"
        android:textColor="@color/kora_ink"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lblMatchResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="monospace"
        android:text="RESULT: --"
        android:textColor="@color/kora_ink"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lblMatchDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="monospace"
        android:text="ENDED: --"
        android:textColor="@color/kora_muted"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_box_outline"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:fontFamily="monospace"
            android:text="#"
            android:textColor="@color/kora_muted"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:fontFamily="monospace"
            android:text="TIME"
            android:textColor="@color/kora_muted"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:fontFamily="monospace"
            android:text="PLAYER"
            android:textColor="@color/kora_muted"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:fontFamily="monospace"
            android:text="MOVE"
            android:textColor="@color/kora_muted"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ListView
        android:id="@+id/lwMoveHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="5dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="2dp" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_neutral"
        android:fontFamily="monospace"
        android:text="Back"
        android:textAllCaps="false"
        android:textColor="@color/kora_ink"
        android:textSize="13sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />
</LinearLayout>
