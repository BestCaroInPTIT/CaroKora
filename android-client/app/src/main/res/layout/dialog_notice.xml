<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_box_outline"
    android:orientation="vertical">

    <TextView
        android:id="@+id/lblNoticeTitle"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@color/kora_mint"
        android:fontFamily="monospace"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:text="NOTICE"
        android:textColor="@color/kora_ink"
        android:textSize="13.5sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/kora_ink" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/kora_cream"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="20dp">

        <TextView
            android:id="@+id/lblNoticeMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="14dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Message"
            android:textColor="@color/kora_ink"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnNoticePrimary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_mint"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="4dp"
                android:text="OK"
                android:textColor="@color/kora_ink"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnNoticeSecondary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_blush"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="4dp"
                android:text="CANCEL"
                android:textColor="@color/kora_ink"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="@null" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
